{
  "annotations": {"list": []},
  "description": "Visão operacional dos microsserviços Wallet Service e Transaction Service, RabbitMQ, métricas JVM e logs centralizados.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Estado da coleta de métricas do Wallet Service.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "OFFLINE"}, "1": {"color": "green", "text": "ONLINE"}}, "type": "value"}], "noValue": "SEM DADOS", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"expr": "up{job=\"wallet-service\"}", "instant": true, "legendFormat": "Wallet Service", "refId": "A"}],
      "title": "Wallet Service",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Estado da coleta de métricas do Transaction Service.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "OFFLINE"}, "1": {"color": "green", "text": "ONLINE"}}, "type": "value"}], "noValue": "SEM DADOS", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"expr": "up{job=\"transaction-service\"}", "instant": true, "legendFormat": "Transaction Service", "refId": "A"}],
      "title": "Transaction Service",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Estado da coleta de métricas do broker RabbitMQ.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "OFFLINE"}, "1": {"color": "green", "text": "ONLINE"}}, "type": "value"}], "noValue": "SEM DADOS", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"expr": "up{job=\"rabbitmq\"}", "instant": true, "legendFormat": "RabbitMQ", "refId": "A"}],
      "title": "RabbitMQ",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Soma da taxa de requisições recebidas pelos dois microsserviços.",
      "fieldConfig": {"defaults": {"decimals": 2, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=~\"wallet-service|transaction-service\"}[$__rate_interval]))", "legendFormat": "requisições/s", "refId": "A"}],
      "title": "Tráfego atual",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Requisições por segundo separadas por serviço e código HTTP.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (job, status) (rate(http_server_requests_seconds_count{job=~\"wallet-service|transaction-service\"}[$__rate_interval]))", "legendFormat": "{{job}} · HTTP {{status}}", "refId": "A"}],
      "title": "Requisições HTTP por serviço",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Percentual de respostas HTTP 5xx em relação ao total de cada serviço.",
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (sum by (job) (rate(http_server_requests_seconds_count{job=~\"wallet-service|transaction-service\",status=~\"5..\"}[$__rate_interval])) or (0 * sum by (job) (rate(http_server_requests_seconds_count{job=~\"wallet-service|transaction-service\"}[$__rate_interval])))) / clamp_min(sum by (job) (rate(http_server_requests_seconds_count{job=~\"wallet-service|transaction-service\"}[$__rate_interval])), 0.001)", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "Taxa de erros HTTP 5xx",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Tempo abaixo do qual 95% das requisições foram concluídas.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"wallet-service|transaction-service\"}[$__rate_interval])))", "legendFormat": "p95 · {{job}}", "refId": "A"}],
      "title": "Latência HTTP p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Quantidade de mensagens prontas ou não confirmadas em cada fila.",
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (queue) (rabbitmq_queue_messages)", "legendFormat": "{{queue}}", "refId": "A"}],
      "title": "Filas RabbitMQ",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Memória heap efetivamente utilizada por cada JVM.",
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (job) (jvm_memory_used_bytes{job=~\"wallet-service|transaction-service\",area=\"heap\"})", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "Memória heap das JVMs",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Percentual de CPU consumido pelos processos Java.",
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * process_cpu_usage{job=~\"wallet-service|transaction-service\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "CPU dos microsserviços",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "Loki"},
      "description": "Logs JSON recentes do Wallet Service. Expanda uma linha para ver traceId, spanId e correlationId.",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 29},
      "id": 11,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"editorMode": "code", "expr": "{service=\"backend\"}", "queryType": "range", "refId": "A"}],
      "title": "Logs ao vivo · Wallet Service",
      "type": "logs"
    },
    {
      "datasource": {"type": "loki", "uid": "Loki"},
      "description": "Logs JSON recentes do Transaction Service. Use o correlationId para acompanhar a mesma operação entre serviços.",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 29},
      "id": 12,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"editorMode": "code", "expr": "{service=\"transaction-service\"}", "queryType": "range", "refId": "A"}],
      "title": "Logs ao vivo · Transaction Service",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["tp5", "wallet-platform", "microservices"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]},
  "timezone": "browser",
  "title": "Wallet Platform — Operação",
  "uid": "wallet-platform-operations",
  "version": 2
}
